# Fichero de ejemplo. Copialo a  .env  y pon tu clave dentro.
#
#     cp .env.ejemplo .env
#
# El .env NO se versiona (esta en .gitignore). Este ejemplo si, para que se
# vea que hace falta sin tener que adivinarlo.
#
# La clave se saca en https://platform.claude.com -> API keys.
# Una variable de entorno ya definida MANDA sobre este fichero, asi que puedes
# saltartelo puntualmente con:  export ANTHROPIC_API_KEY=...

ANTHROPIC_API_KEY=
