# ---- credenciales -------------------------------------------------------
# Nunca al repositorio. El .env.ejemplo si se versiona (va sin valor).
.env
.env.*
!.env.ejemplo

# ---- entorno de Python --------------------------------------------------
.venv/
__pycache__/
*.pyc
*.pyo

# ---- datos ---------------------------------------------------------------
#
# POR DEFECTO, NADA DE datos/ VIAJA. Son megas de texto que se regeneran
# ingiriendo del BOE con `python3 fase1.py ingerir <ID>`.
#
# CON UNA EXCEPCION: LA DESPENSA DE CRITERIO. En la oficina no hay USB y se
# instala con `git pull`, asi que las consultas de la DGT y las resoluciones
# del TEAC -que se tardan HORAS en sembrar, no se regeneran solas y son
# documentos publicos- tienen que llegar por aqui.
#
# `datos/*` y no `datos/`: git no entra en un directorio excluido, asi que con
# la regla puesta al directorio entero ningun `!` de dentro se llega a mirar.
datos/*

# La despensa SI viaja.
!datos/dgt/
!datos/teac/

# Pero de ella, solo los documentos. NO el HTML tal cual -67 MB de los 134, y
# no lo lee nadie en marcha: solo la ingesta, para poder volver a mirarlo-. Ni
# los registros de la siembra, que son de esta maquina.
datos/dgt/crudo/
datos/teac/crudo/
datos/dgt/busquedas/
datos/teac/busquedas/
datos/*/*.log

# LAS TRAZAS NO SALEN DEL DESPACHO. Son las dudas reales de los clientes, con
# sus nombres y sus cifras. Estan cubiertas por `datos/*`, y se repite aqui
# por si algun dia alguien afloja la regla de arriba: mejor decirlo dos veces
# que descubrirlo una.
datos/trazas/

bruto/
corpus/
crudo/

# ---- la guia de la mesa: SE GENERA, no viaja ----------------------------
# `GUIA.md` sale de `guias/GUIA.md` -que si viaja- mas lo que hay en la
# despensa de ESTA maquina. Versionarla tenia dos problemas a la vez: cada
# equipo la reescribe al instalar, asi que el siguiente `git pull` se
# encuentra el arbol sucio y no puede avanzar; y ademas haria viajar una foto
# de la despensa de otro ordenador. La fuente viaja, la copia se hace aqui.
/GUIA.md

# ---- herramientas -------------------------------------------------------
# settings.local.json guarda los comandos que se han autorizado, y un comando
# escrito con la clave en linea acabaria dentro.
.claude/settings.local.json
.DS_Store

# ---- LO QUE BAJA LA COLA NO SALE DEL DESPACHO -------------------------------
# `datos/dgt/consultas/` viaja: esta sembrado POR PLAN y refleja lo que
# decidimos sembrar, no lo que pregunta nadie.
#
# `datos/dgt/demanda/` lo llena la cola con lo que PREGUNTA el departamento. El
# contenido de una consulta de la DGT es publico y no lleva datos de nadie,
# pero EL CONJUNTO Y LAS FECHAS si: un commit del martes con tres consultas
# sobre reduccion de empresa familiar dice que ese martes un cliente pregunto
# por una sucesion de empresa familiar. Git guarda eso para siempre.
#
# Mismo criterio que el corpus y las trazas: VIAJA LO CARO QUE NO DICE NADA DE
# NADIE; NO VIAJA LO BARATO QUE SI LO DICE. La siembra por plan son horas
# contra un servicio publico; la demanda son una o dos consultas, y no hay nada
# que ahorrar compartiendolas.
#
# Y LA COLA TAMPOCO, que dice que articulos se han preguntado.
datos/dgt/demanda/
datos/dgt/cola.json

# El diagnostico del equipo: se genera en cada maquina y es de esa maquina.
diagnostico.txt
datos/arranque_fallido.txt

# La marca de «ya lo vi»: es de ESTE equipo, no viaja.
datos/dgt/visto.json

# EL INDICE DE LA CACHE DE LA DGT: numero de consulta -> id interno de PETETE.
#
# VIAJABA Y SE REESCRIBIA EN CADA MAQUINA, que es la combinacion que rompe el
# `git pull`: la cola por demanda de la oficina lo tocaba en cuanto bajaba algo,
# y el pull siguiente se negaba a fusionar por «cambios locales». Un derivado no
# vale una actualizacion parada: se rehace de los documentos, que llevan dentro
# su `doc_id` y su `tab` -2.734 en 2,9 s, medido-.
#
# LO QUE CUESTA, dicho: se pierden los ids que se aprendieron BUSCANDO sin
# llegar a descargar el documento -2.483 de los 5.217 de este Mac-. No es dato,
# es cache templada: se vuelven a aprender solos, uno por consulta que se pida y
# no tengamos, en la misma busqueda que habria hecho falta igualmente.
datos/dgt/indice.json

# El avance del goteo: es de ESTE Mac, del proceso que solo corre aqui.
# Si viajara, la oficina tendria el avance de un barrido que no hace, y una
# copia de alla podria pisar el mio.
datos/dgt/goteo.json

# El cerrojo de la sesion de goteo. Dice que hay un proceso corriendo EN ESTE
# Mac; en otra maquina seria mentira desde el primer momento, y una mentira que
# impediria gotear.
datos/dgt/goteo.cerrojo
